<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_executor</name>
  <version>0.0.0</version>
  <description>Executes missions: two sequences of manoeuvres, one per vehicle, chained by events</description>
  <maintainer email="tomasesteves03@gmail.com">Tomás Esteves</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>mission_maneuvers</depend>
  <exec_depend>intruder_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
